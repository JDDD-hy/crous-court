# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem
*.key
*.sqlite
*.sqlite3
*.sqlite-*
*.db
*.db-*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars
.dev.vars.*
!.dev.vars.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
# Local project notes; never publish them with source or deployments.
/docs/
/AGENTS.md
/DOCUMENT_MAP.md
/CONTEXT.md
/research/
# User-owned source photos; only sanitized derivatives belong in public/.
/pic/
