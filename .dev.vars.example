# Copy to `.dev.vars`, replace every placeholder, and never commit it.
# `local-resend` sends real email while keeping localhost-only cookies.
AUTH_MODE=local-resend
AUTH_HMAC_SECRET=change-me
RESEND_API_KEY=replace-with-your-resend-api-key
OTP_FROM_EMAIL=CROUS法庭 <login@crouscourt.fun>

# `crouscourt.fun` is the verified sender domain; keep the local file private.
